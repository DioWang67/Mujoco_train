# Copy to .env.remote and fill values for your machine.
# .env.remote is ignored by git; do not commit real passwords.

REMOTE_HOST=root@10.6.243.55
REMOTE_ROOT=/root/anaconda3/mujoco-train-system
REMOTE_PROJECT_SLUG=sedon
REMOTE_VERIFY_PROJECT=sedon

# working-tree includes current tracked/untracked non-ignored files.
# git-ref deploys the committed ref from REMOTE_DEPLOY_REF.
REMOTE_SOURCE_MODE=working-tree
REMOTE_DEPLOY_REF=HEAD

# Leave empty when using SSH keys.
# With a password, the tool prefers Python Paramiko. PuTTY plink/pscp or
# sshpass are fallback backends.
REMOTE_PASSWORD=ubuntu
REMOTE_SSH_BACKEND=askpass

# Set this to 1 only when the remote does not already have private_assets.
# Keeping it 0 makes normal code/config deploys much faster.
REMOTE_INCLUDE_PRIVATE_ASSETS=0
REMOTE_INCLUDE_EXTRA_ASSETS=0
REMOTE_CLEAN_RELEASE=0
REMOTE_CONNECT_TIMEOUT=10
REMOTE_STRICT_HOST_KEY_CHECKING=accept-new
REMOTE_PYTHON=/root/anaconda3/bin/python
REMOTE_SMOKE_ARGS=--smoke

# Sedon resume-training defaults used by tools.remote_training.
SEDON_RESUME_CONFIG=configs/sedon/blue_dynamic_support_gait.json
SEDON_RESUME_TOTAL_TIMESTEPS=2000000
SEDON_RESUME_N_ENVS=128
SEDON_RESUME_RESET_NOISE_SCALE=0.005

# Generic fallback names if a project does not define <PROJECT>_RESUME_* keys.
REMOTE_TRAIN_RESUME_TOTAL_TIMESTEPS=2000000
REMOTE_TRAIN_RESUME_N_ENVS=128
REMOTE_TRAIN_RESUME_RESET_NOISE_SCALE=0.005
REMOTE_TRAIN_RESUME_EXTRA_ARGS=

# Optional deployment overlay:
# put files under deploy_content/<repo-relative-path> and run
# scripts\sedon_remote_deploy_and_check.bat.
